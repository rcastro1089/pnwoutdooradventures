---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import HeroSection from "../components/HeroSection.astro";
import TrailCard from "../components/TrailCard.astro";

const featuredTrails = [
  {
    title: "Rattlesnake Ledge",
    slug: "rattlesnake-ledge",
    image: "https://images.unsplash.com/photo-1551632811-561732d1e306?w=800",
    location: "North Bend, WA",
    distance: "4 miles roundtrip",
    difficulty: "easy" as const,
    rating: 4.8,
    reviews: 1247,
  },
  {
    title: "Twin Falls Trail",
    slug: "twin-falls",
    image: "https://images.unsplash.com/photo-1433086966358-54859d0ed716?w=800",
    location: "Snoqualmie, WA",
    distance: "2.6 miles roundtrip",
    difficulty: "easy" as const,
    rating: 4.7,
    reviews: 892,
  },
  {
    title: "Snow Lake Trail",
    slug: "snow-lake",
    image: "https://images.unsplash.com/photo-1506905925346-21bda4d32df4?w=800",
    location: "Snoqualmie Pass, WA",
    distance: "7 miles roundtrip",
    difficulty: "moderate" as const,
    rating: 4.9,
    reviews: 654,
  },
  {
    title: "Lake Serene Trail",
    slug: "lake-serene",
    image: "https://images.unsplash.com/photo-1472396961693-142e6e269027?w=800",
    location: "Index, WA",
    distance: "7.4 miles roundtrip",
    difficulty: "moderate" as const,
    rating: 4.8,
    reviews: 523,
  },
  {
    title: "Mount Si Trail",
    slug: "mount-si",
    image: "https://images.unsplash.com/photo-1464822759023-fed622ff2c3b?w=800",
    location: "North Bend, WA",
    distance: "8 miles roundtrip",
    difficulty: "hard" as const,
    rating: 4.7,
    reviews: 1089,
  },
  {
    title: "Wallace Falls Trail",
    slug: "wallace-falls",
    image: "https://images.unsplash.com/photo-1432405972618-c6b0c0d40b2f?w=800",
    location: "Gold Bar, WA",
    distance: "5.6 miles roundtrip",
    difficulty: "moderate" as const,
    rating: 4.6,
    reviews: 412,
  },
];

const categories = [
  {
    name: "Hiking",
    icon: "🥾",
    count: "50+ trails",
    href: "/hiking/",
    color: "bg-green-100 text-green-700",
  },
  {
    name: "Camping",
    icon: "⛺",
    count: "20+ sites",
    href: "/camping/",
    color: "bg-amber-100 text-amber-700",
  },
  {
    name: "Water",
    icon: "🛶",
    count: "15+ spots",
    href: "/water/",
    color: "bg-blue-100 text-blue-700",
  },
  {
    name: "Winter",
    icon: "⛷️",
    count: "8 resorts",
    href: "/winter/",
    color: "bg-purple-100 text-purple-700",
  },
];
---

<BaseLayout
  title="PNW Outdoor Adventures"
  description="Discover the best hiking, camping, and outdoor adventures in the Pacific Northwest. Trail guides, campsite reviews, and expert tips for Seattle and beyond."
>
  <Header slot="header" />

  <HeroSection
    title="Explore the Wild Pacific Northwest"
    subtitle="Your complete guide to hiking, camping, and outdoor adventures in Washington State."
  />

  <!-- Categories -->
  <section class="section-padding bg-gray-50" id="featured">
    <div class="container-custom">
      <div class="text-center mb-12">
        <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">
          What are you looking for?
        </h2>
        <p class="text-gray-600 max-w-2xl mx-auto">
          From easy waterfall walks to challenging mountain summits, find your perfect outdoor adventure.
        </p>
      </div>

      <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        {categories.map((cat) => (
          <a
            href={cat.href}
            class="flex flex-col items-center p-6 bg-white rounded-2xl shadow-sm hover:shadow-md transition-shadow group"
          >
            <span class="text-4xl mb-3">{cat.icon}</span>
            <h3 class="font-semibold text-gray-900 group-hover:text-primary transition-colors">
              {cat.name}
            </h3>
            <p class="text-sm text-gray-500">{cat.count}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Featured Trails -->
  <section class="section-padding">
    <div class="container-custom">
      <div class="flex items-center justify-between mb-8">
        <div>
          <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-2">
            Popular Trails
          </h2>
          <p class="text-gray-600">
            The most loved hikes near Seattle
          </p>
        </div>
        <a href="/hiking/" class="btn-pill hidden sm:flex">
          View All Trails
          <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </a>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {featuredTrails.map((trail) => (
          <TrailCard {...trail} />
        ))}
      </div>

      <div class="mt-8 text-center sm:hidden">
        <a href="/hiking/" class="btn-secondary">
          View All Trails
        </a>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="section-padding bg-primary">
    <div class="container-custom text-center">
      <h2 class="text-3xl md:text-4xl font-bold text-white mb-4">
        Ready for Your Next Adventure?
      </h2>
      <p class="text-white/80 max-w-2xl mx-auto mb-8">
        Download our complete trail guide bundle with 50+ trails, maps, and insider tips.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/products/" class="inline-flex items-center justify-center px-8 py-4 bg-white text-primary font-semibold rounded-lg hover:bg-gray-100 transition-colors">
          Get the Bundle — $49
        </a>
        <a href="/hiking/" class="inline-flex items-center justify-center px-8 py-4 bg-transparent text-white font-semibold rounded-lg border-2 border-white hover:bg-white/10 transition-colors">
          Explore Free Guides
        </a>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>
