---
import ArticleLayout from "../../layouts/ArticleLayout.astro";

const trail = {
  title: "Lake Serene Trail",
  description: "Lake Serene Trail combines a stunning waterfall with an alpine lake, offering one of the most rewarding hikes near Seattle. 7.4 miles with 2,000 ft elevation gain.",
  image: "https://images.unsplash.com/photo-1472396961693-142e6e269027?w=1200",
  location: "Index, WA",
  distance: "7.4 miles roundtrip",
  elevation: "2,000 ft",
  difficulty: "moderate" as const,
  time: "4-6 hours",
};
---

<ArticleLayout {...trail}>
  <!-- Quick Verdict -->
  <div class="p-6 bg-green-50 rounded-2xl mb-10">
    <h2 class="text-xl font-bold text-gray-900 mb-2">The Bottom Line</h2>
    <p class="text-gray-700">Two-for-one deal: a gorgeous waterfall AND an alpine lake on the same trail. Lake Serene doesn't get the love it deserves, which means fewer crowds than similar hikes. Your Instagram will thank you.</p>
    <div class="mt-4 flex flex-wrap gap-4 text-sm">
      <span class="px-3 py-1 bg-white rounded-full">✓ Bridal Veil Falls AND Lake Serene</span>
      <span class="px-3 py-1 bg-white rounded-full">✓ Fewer crowds than expected</span>
      <span class="px-3 py-1 bg-white rounded-full">✓ Diverse scenery</span>
      <span class="px-3 py-1 bg-white rounded-full">✓ Great swimming hole</span>
    </div>
  </div>

  <!-- Overview -->
  <section class="mb-12">
    <h2 class="text-2xl font-bold text-gray-900 mb-4">What You're Getting Into</h2>
    <p class="text-gray-600 mb-4">A waterfall that would be the main attraction anywhere else. Here, it's just the warm-up.</p>
    <!-- Quick Facts -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mt-6 p-4 bg-gray-50 rounded-xl">
      <div>
        <p class="text-sm text-gray-500">Distance</p>
        <p class="font-medium">7.4 miles roundtrip</p>
      </div>
      <div>
        <p class="text-sm text-gray-500">Elevation Gain</p>
        <p class="font-medium">2,000 ft</p>
      </div>
      <div>
        <p class="text-sm text-gray-500">Difficulty</p>
        <p class="font-medium">Moderate</p>
      </div>
      <div>
        <p class="text-sm text-gray-500">Time</p>
        <p class="font-medium">4-6 hours</p>
      </div>
    </div>
  </section>

  <!-- The Trail -->
  <section class="mb-12">
    <h2 class="text-2xl font-bold text-gray-900 mb-4">The Trail</h2>
    <div class="space-y-6">
      <div class="p-4 border-l-4 border-primary">
        <h3 class="font-semibold text-gray-900">Mile 0-1.5: Bridal Veil Falls</h3>
        <p class="text-gray-600 mt-2">A waterfall that would be the main attraction anywhere else. Here, it's just the warm-up.</p>
      </div>
      <div class="p-4 border-l-4 border-primary">
        <h3 class="font-semibold text-gray-900">Mile 1.5-3.7: The Climb</h3>
        <p class="text-gray-600 mt-2">Steeper section through old-growth forest. You'll earn those lake views.</p>
      </div>
      <div class="p-4 border-l-4 border-primary">
        <h3 class="font-semibold text-gray-900">Mile 3.7: Lake Serene</h3>
        <p class="text-gray-600 mt-2">Crystal clear alpine lake with mountain backdrop. Bring a towel.</p>
      </div>
    </div>
  </section>

  <!-- Pro Tips -->
  <section class="mb-12">
    <h2 class="text-2xl font-bold text-gray-900 mb-4">Pro Tips</h2>
    <div class="space-y-3">
      <div class="p-4 bg-blue-50 rounded-xl">
        <p class="text-blue-800">💡 Pack a lunch for the lake</p>
      </div>
      <div class="p-4 bg-blue-50 rounded-xl">
        <p class="text-blue-800">💡 Best swimming in late July/August</p>
      </div>
      <div class="p-4 bg-blue-50 rounded-xl">
        <p class="text-blue-800">💡 The falls are best in spring</p>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="p-8 bg-primary rounded-2xl text-center">
    <h3 class="text-xl font-bold text-white mb-3">Ready to Hit the Trail?</h3>
    <p class="text-white/80 mb-4">Download our complete PNW trail guide with 50+ hikes.</p>
    <a href="/products/" class="inline-flex items-center justify-center px-8 py-4 bg-white text-primary font-semibold rounded-lg hover:bg-gray-100 transition-colors">
      Get the Trail Guide — $29
    </a>
  </section>
</ArticleLayout>
