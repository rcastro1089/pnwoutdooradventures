---
interface Props {
  title: string;
  slug: string;
  image: string;
  location: string;
  distance: string;
  difficulty: "easy" | "moderate" | "hard";
  rating: number;
  reviews: number;
}

const {
  title,
  slug,
  image,
  location,
  distance,
  difficulty,
  rating,
  reviews,
} = Astro.props;

const difficultyConfig = {
  easy: { label: "Easy", class: "badge-easy" },
  moderate: { label: "Moderate", class: "badge-moderate" },
  hard: { label: "Hard", class: "badge-hard" },
};
---

<a href={`/hiking/${slug}/`} class="card group block">
  <!-- Image -->
  <div class="relative aspect-[16/10] overflow-hidden">
    <img
      src={image}
      alt={title}
      class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
      loading="lazy"
    />
    <!-- Difficulty Badge -->
    <div class="absolute top-3 left-3">
      <span class={difficultyConfig[difficulty].class}>
        {difficultyConfig[difficulty].label}
      </span>
    </div>
    <!-- Wishlist -->
    <button
      type="button"
      class="absolute top-3 right-3 p-2 bg-white/90 rounded-full opacity-0 group-hover:opacity-100 transition-opacity hover:bg-white"
      aria-label="Save trail"
    >
      <svg class="w-5 h-5 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
      </svg>
    </button>
  </div>

  <!-- Content -->
  <div class="p-4">
    <!-- Location -->
    <p class="text-sm text-gray-500 mb-1 flex items-center gap-1">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
      </svg>
      {location}
    </p>

    <!-- Title -->
    <h3 class="font-semibold text-lg text-gray-900 mb-2 group-hover:text-primary transition-colors">
      {title}
    </h3>

    <!-- Meta -->
    <div class="flex items-center justify-between">
      <span class="text-sm text-gray-600 flex items-center gap-1">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" />
        </svg>
        {distance}
      </span>

      <!-- Rating -->
      <div class="flex items-center gap-1">
        <svg class="w-4 h-4 text-yellow-400" fill="currentColor" viewBox="0 0 20 20">
          <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
        </svg>
        <span class="text-sm font-medium text-gray-900">{rating}</span>
        <span class="text-sm text-gray-500">({reviews})</span>
      </div>
    </div>
  </div>
</a>
