---
// Cookie Consent Banner - CCPA/GDPR Compliant
// Stores consent in localStorage, only loads GA after consent
---

<div id="cookie-banner" class="fixed bottom-0 left-0 right-0 z-50 hidden">
  <div class="bg-gray-900 text-white shadow-2xl">
    <div class="container-custom py-4 px-4 md:px-6">
      <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-4">
        
        <!-- Text -->
        <div class="flex-1">
          <p class="text-sm md:text-base text-gray-300">
            🍪 We use cookies to improve your experience and analyze site traffic. 
            By clicking "Accept All", you consent to our use of cookies. 
            <a href="/legal/cookies/" class="underline hover:text-white">Learn more</a>
          </p>
        </div>

        <!-- Buttons -->
        <div class="flex flex-wrap gap-2 w-full md:w-auto">
          <button 
            id="cookie-accept-all"
            class="px-4 py-2 bg-primary text-white text-sm font-medium rounded-lg hover:bg-primary-dark transition-colors flex-1 md:flex-none"
          >
            Accept All
          </button>
          <button 
            id="cookie-reject-all"
            class="px-4 py-2 bg-gray-700 text-white text-sm font-medium rounded-lg hover:bg-gray-600 transition-colors flex-1 md:flex-none"
          >
            Reject All
          </button>
          <button 
            id="cookie-customize"
            class="px-4 py-2 bg-transparent text-gray-300 text-sm font-medium rounded-lg border border-gray-600 hover:border-gray-400 hover:text-white transition-colors flex-1 md:flex-none"
          >
            Customize
          </button>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Customize Modal -->
<div id="cookie-modal" class="fixed inset-0 z-50 hidden">
  <div class="absolute inset-0 bg-black/50 backdrop-blur-sm" id="cookie-modal-overlay"></div>
  <div class="absolute inset-4 md:inset-auto md:top-1/2 md:left-1/2 md:-translate-x-1/2 md:-translate-y-1/2 md:w-full md:max-w-lg md:max-h-[80vh] bg-white rounded-2xl shadow-2xl overflow-hidden flex flex-col">
    
    <!-- Modal Header -->
    <div class="px-6 py-4 border-b border-gray-200">
      <h2 class="text-lg font-bold text-gray-900">Cookie Preferences</h2>
    </div>

    <!-- Modal Content -->
    <div class="px-6 py-4 overflow-y-auto flex-1">
      
      <!-- Essential Cookies -->
      <div class="mb-4">
        <div class="flex items-center justify-between">
          <div>
            <h3 class="font-medium text-gray-900">Essential Cookies</h3>
            <p class="text-sm text-gray-500">Required for the site to function</p>
          </div>
          <span class="text-sm text-gray-400">Always Active</span>
        </div>
      </div>

      <!-- Analytics Cookies -->
      <div class="mb-4 p-4 bg-gray-50 rounded-xl">
        <div class="flex items-center justify-between">
          <div>
            <h3 class="font-medium text-gray-900">Analytics Cookies</h3>
            <p class="text-sm text-gray-500">Help us understand how visitors interact with our site</p>
          </div>
          <label class="relative inline-flex items-center cursor-pointer">
            <input 
              type="checkbox" 
              id="cookie-analytics" 
              class="sr-only peer"
              checked
            >
            <div class="w-11 h-6 bg-gray-300 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-primary"></div>
          </label>
        </div>
        <p class="text-xs text-gray-500 mt-2">
          Google Analytics (G-4PCZ6F0C5M) - Tracks page views, user behavior, and site performance.
        </p>
      </div>

      <!-- Marketing Cookies -->
      <div class="mb-4 p-4 bg-gray-50 rounded-xl">
        <div class="flex items-center justify-between">
          <div>
            <h3 class="font-medium text-gray-900">Marketing Cookies</h3>
            <p class="text-sm text-gray-500">Used to deliver relevant ads</p>
          </div>
          <label class="relative inline-flex items-center cursor-pointer">
            <input 
              type="checkbox" 
              id="cookie-marketing" 
              class="sr-only peer"
            >
            <div class="w-11 h-6 bg-gray-300 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-primary"></div>
          </label>
        </div>
        <p class="text-xs text-gray-500 mt-2">
          Used for retargeting and ad personalization.
        </p>
      </div>

      <!-- Privacy Info -->
      <div class="p-4 bg-blue-50 rounded-xl">
        <p class="text-sm text-blue-800">
          🔒 Your privacy is important to us. Read our 
          <a href="/legal/privacidad/" class="underline font-medium">Privacy Policy</a> 
          to learn how we collect, use, and protect your personal information.
        </p>
      </div>
    </div>

    <!-- Modal Footer -->
    <div class="px-6 py-4 border-t border-gray-200 bg-gray-50">
      <div class="flex flex-wrap gap-2">
        <button 
          id="cookie-save-preferences"
          class="px-4 py-2 bg-primary text-white text-sm font-medium rounded-lg hover:bg-primary-dark transition-colors flex-1"
        >
          Save Preferences
        </button>
        <button 
          id="cookie-modal-close"
          class="px-4 py-2 bg-gray-200 text-gray-700 text-sm font-medium rounded-lg hover:bg-gray-300 transition-colors flex-1"
        >
          Cancel
        </button>
      </div>
    </div>
  </div>
</div>

<script>
  // Cookie Consent Manager
  class CookieConsent {
    constructor() {
      this.banner = document.getElementById('cookie-banner');
      this.modal = document.getElementById('cookie-modal');
      this.overlay = document.getElementById('cookie-modal-overlay');
      
      this.analyticsCheckbox = document.getElementById('cookie-analytics');
      this.marketingCheckbox = document.getElementById('cookie-marketing');
      
      this.consentKey = 'pnw_cookie_consent';
      this.gaLoaded = false;
      
      this.init();
    }

    init() {
      // Check if consent already given
      const consent = this.getConsent();
      
      if (consent === null) {
        // No consent yet - show banner
        this.showBanner();
      } else if (consent.analytics) {
        // Consent given with analytics - load GA
        this.loadGoogleAnalytics();
      }
      
      // Bind button events
      this.bindEvents();
    }

    bindEvents() {
      // Accept All
      document.getElementById('cookie-accept-all')?.addEventListener('click', () => {
        this.saveConsent({ analytics: true, marketing: true });
        this.hideBanner();
        this.loadGoogleAnalytics();
      });

      // Reject All
      document.getElementById('cookie-reject-all')?.addEventListener('click', () => {
        this.saveConsent({ analytics: false, marketing: false });
        this.hideBanner();
      });

      // Customize - Open Modal
      document.getElementById('cookie-customize')?.addEventListener('click', () => {
        this.openModal();
      });

      // Save Preferences
      document.getElementById('cookie-save-preferences')?.addEventListener('click', () => {
        const preferences = {
          analytics: this.analyticsCheckbox?.checked || false,
          marketing: this.marketingCheckbox?.checked || false
        };
        this.saveConsent(preferences);
        this.hideModal();
        this.hideBanner();
        if (preferences.analytics) {
          this.loadGoogleAnalytics();
        }
      });

      // Close Modal
      document.getElementById('cookie-modal-close')?.addEventListener('click', () => {
        this.hideModal();
      });

      // Close on overlay click
      this.overlay?.addEventListener('click', () => {
        this.hideModal();
      });

      // Close on Escape key
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
          this.hideModal();
        }
      });
    }

    showBanner() {
      this.banner?.classList.remove('hidden');
    }

    hideBanner() {
      this.banner?.classList.add('hidden');
    }

    openModal() {
      // Load current preferences into checkboxes
      const consent = this.getConsent();
      if (consent) {
        if (this.analyticsCheckbox) this.analyticsCheckbox.checked = consent.analytics;
        if (this.marketingCheckbox) this.marketingCheckbox.checked = consent.marketing;
      }
      this.modal?.classList.remove('hidden');
    }

    hideModal() {
      this.modal?.classList.add('hidden');
    }

    saveConsent(preferences) {
      const consentData = {
        analytics: preferences.analytics,
        marketing: preferences.marketing,
        timestamp: new Date().toISOString(),
        version: '1.0'
      };
      
      try {
        localStorage.setItem(this.consentKey, JSON.stringify(consentData));
      } catch (e) {
        console.warn('Failed to save cookie consent:', e);
      }
    }

    getConsent() {
      try {
        const data = localStorage.getItem(this.consentKey);
        return data ? JSON.parse(data) : null;
      } catch (e) {
        return null;
      }
    }

    loadGoogleAnalytics() {
      if (this.gaLoaded) return;
      
      // Check if analytics consent was given
      const consent = this.getConsent();
      if (!consent?.analytics) return;

      // Load Google Analytics
      const script1 = document.createElement('script');
      script1.async = true;
      script1.src = 'https://www.googletagmanager.com/gtag/js?id=G-4PCZ6F0C5M';
      document.head.appendChild(script1);

      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-4PCZ6F0C5M', {
        'anonymize_ip': true,
        'cookie_flags': 'SameSite=None;Secure'
      });

      this.gaLoaded = true;
      console.log('Google Analytics loaded with consent');
    }
  }

  // Initialize when DOM is ready
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => new CookieConsent());
  } else {
    new CookieConsent();
  }
</script>

<style>
  /* Toggle switch animation */
  .peer:checked + div {
    background-color: #2D5016;
  }
  
  .peer:checked + div::after {
    transform: translateX(100%);
  }

  /* Smooth transitions */
  #cookie-banner {
    animation: slideUp 0.3s ease-out;
  }
  
  @keyframes slideUp {
    from {
      transform: translateY(100%);
      opacity: 0;
    }
    to {
      transform: translateY(0);
      opacity: 1;
    }
  }

  /* Modal animation */
  #cookie-modal:not(.hidden) > div:first-child {
    animation: fadeIn 0.2s ease-out;
  }
  
  #cookie-modal:not(.hidden) > div:last-child {
    animation: scaleIn 0.2s ease-out;
  }
  
  @keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }
  
  @keyframes scaleIn {
    from { 
      opacity: 0;
      transform: scale(0.95);
    }
    to { 
      opacity: 1;
      transform: scale(1);
    }
  }
</style>
